---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Danila Macijauskas" description="This page does not exist.">
  <section class="hero" aria-labelledby="nf">
    <p class="prompt-line" aria-hidden="true"><span class="prompt-path">~</span> <span class="prompt-sigil">$</span> cd missing-page</p>
    <h1 id="nf">404: page not found</h1>
    <p class="lede">There is nothing at this address.</p>
    <p><a href="/">Back to the home page</a></p>
  </section>
</Base>
